# ============================================================
# CatatanPengeluaran - Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# --- Telegram ---
TELEGRAM_TOKEN=your_bot_token_here
BOT_PASSWORD=12345
ALLOWED_THREAD_ID=7

# --- Database ---
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/catatan_pengeluaran

# --- AI: Sumopod ---
SUMOPOD_API_KEY=sk-your-sumopod-key-here
SUMOPOD_URL=https://ai.sumopod.com/v1/chat/completions
SUMOPOD_MODEL=seed-2-0-mini

# --- Google Sheets (opsional, untuk sync) ---
SPREADSHEET_ID=your_spreadsheet_id_here
GOOGLE_CREDENTIALS_JSON=credentials.json

# --- App ---
APP_HOST=0.0.0.0
APP_PORT=8000
WEBHOOK_URL=https://yourdomain.com/webhook
SECRET_KEY=change_this_to_a_random_secret_string
# Skema database dikelola Alembic. Jangan set true di produksi.
AUTO_CREATE_TABLES=false

# --- Scheduler ---
# Format: HH:MM (waktu kirim laporan otomatis, WIB)
AUTO_REPORT_TIME=08:00
# ID Telegram untuk terima laporan otomatis (bisa chat ID atau user ID)
REPORT_CHAT_ID=your_chat_id_here
REPORT_THREAD_ID=7

# --- Dashboard PIN & Proteksi Anti-Brute Force ---
# Chat ID tujuan pengiriman PIN (opsional, jika kosong fallback ke REPORT_CHAT_ID atau user aktif)
DASHBOARD_PIN_CHAT_ID=your_chat_id_here
DASHBOARD_PIN_THREAD_ID=7
# Durasi cookie sesi login (jam)
DASHBOARD_SESSION_EXPIRE_HOURS=24
# Masa berlaku PIN (detik, default 300 = 5 menit)
DASHBOARD_PIN_EXPIRE_SECONDS=300
# Cooldown antar permintaan PIN (detik, default 60 = 1 menit)
DASHBOARD_PIN_COOLDOWN_SECONDS=60
# Batas maksimal percobaan salah per PIN sebelum PIN hangus
DASHBOARD_PIN_MAX_ATTEMPTS=3
# Batas percobaan salah berturut-turut dari IP yang sama sebelum IP di-lockout
DASHBOARD_LOCKOUT_ATTEMPTS=5
# Durasi lockout IP (menit)
DASHBOARD_LOCKOUT_MINUTES=15
